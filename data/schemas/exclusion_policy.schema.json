{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rx-quality-check.local/schemas/exclusion_policy.schema.json",
  "title": "Rx Recall Check exclusion policy (schema 2)",
  "description": "Medications recognized but deliberately not assessed. Runtime authority: mobile/src/rules/catalog.ts (validation) and mobile/src/rules/exclusion.ts (precedence).",
  "type": "object",
  "required": ["schema_version", "policy_version", "status", "effective_date", "last_reviewed", "next_review_due", "compatibility", "principles", "classes", "ingredient_rules", "route_rules", "product_type_rules", "change_log"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "policy_version": { "$ref": "#/definitions/version" },
    "status": { "enum": ["APPROVED", "DRAFT_PENDING_APPROVAL", "PROPOSED_PENDING_APPROVAL", "RETIRED"] },
    "effective_date": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/date" }] },
    "last_reviewed": { "$ref": "#/definitions/date" },
    "next_review_due": { "$ref": "#/definitions/date" },
    "review_interval_months": { "type": "integer", "minimum": 1, "maximum": 6 },
    "compatibility": {
      "type": "object",
      "required": ["min_ruleset_version"],
      "properties": { "min_ruleset_version": { "$ref": "#/definitions/version" } },
      "additionalProperties": false
    },
    "source_document": { "type": "string" },
    "principles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criterion", "rationale", "explanation", "fda_epc_signals", "unlisted_signal_behavior"],
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "criterion": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "fda_epc_signals": { "type": "array", "items": { "type": "string" } },
          "unlisted_signal_behavior": { "enum": ["NEEDS_CLARIFICATION", "EXCLUDED", "IGNORE"] }
        },
        "additionalProperties": false
      }
    },
    "ingredient_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ingredient", "rxcuis", "names", "class", "decision", "include_combinations", "source", "verified_on"],
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "ingredient": { "type": "string", "minLength": 1 },
          "rxcuis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/rxcui" } },
          "names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "class": { "$ref": "#/definitions/ruleId" },
          "decision": { "enum": ["EXCLUDED", "NEEDS_CLARIFICATION"] },
          "applies_to": { "$ref": "#/definitions/scope" },
          "include_combinations": { "type": "boolean" },
          "explanation": { "type": "string" },
          "note": { "type": "string" },
          "route_note": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "verified_on": { "$ref": "#/definitions/date" }
        },
        "additionalProperties": false
      }
    },
    "route_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "routes", "scope"],
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "status": { "enum": ["OPEN_DECISION", "APPROVED"] },
          "decision_id": { "type": "string" },
          "routes": { "oneOf": [{ "const": "NON_ORAL" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }] },
          "scope": { "enum": ["LISTED_INGREDIENTS", "ALL"] },
          "decision": { "enum": ["EXCLUDED", "NEEDS_CLARIFICATION"] },
          "interim_decision": { "enum": ["UNSUPPORTED", "NEEDS_CLARIFICATION"] },
          "interim_reason": { "type": "string" },
          "statement": { "type": "string" },
          "interim_behavior": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "product_type_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "product_types", "decision", "explanation", "source"],
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "product_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decision": { "enum": ["EXCLUDED", "NEEDS_CLARIFICATION"] },
          "explanation": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "decided_on": { "$ref": "#/definitions/date" }
        },
        "additionalProperties": false
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["date", "version", "change", "source"] }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rxcui": { "type": "string", "pattern": "^\\d+$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" },
    "scope": {
      "type": "object",
      "properties": {
        "routes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dose_forms": { "type": "array", "minItems": 1, "items": { "enum": ["TABLET", "CAPSULE", "SOLUTION", "SUSPENSION", "OTHER"] } },
        "release_types": { "type": "array", "minItems": 1, "items": { "enum": ["IR", "ER", "DR"] } }
      },
      "additionalProperties": false
    }
  }
}
