{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rx-quality-check.local/schemas/drug_catalog.schema.json",
  "title": "Rx Recall Check drug catalog (schema 2)",
  "description": "Supported-drug catalog. Ingredient definitions are separate from drug/formulation eligibility. Runtime authority: mobile/src/rules/catalog.ts (also checks references, duplicates and compatibility, which JSON Schema cannot).",
  "type": "object",
  "required": ["schema_version", "catalog_version", "status", "effective_date", "compatibility", "scope_defaults", "ingredients", "drugs", "change_log"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "catalog_version": { "$ref": "#/definitions/version" },
    "status": { "enum": ["APPROVED", "DRAFT_PENDING_APPROVAL", "PROPOSED_PENDING_APPROVAL", "RETIRED"] },
    "effective_date": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/date" }] },
    "compatibility": {
      "type": "object",
      "required": ["min_ruleset_version"],
      "properties": { "min_ruleset_version": { "$ref": "#/definitions/version" } },
      "additionalProperties": false
    },
    "description": { "type": "string" },
    "provenance": { "type": "object" },
    "scope_defaults": {
      "type": "object",
      "required": ["routes", "rx_scope", "ingredient_set_match"],
      "properties": {
        "routes": { "$ref": "#/definitions/nonEmptyStrings" },
        "rx_scope": { "$ref": "#/definitions/rxScope" },
        "ingredient_set_match": { "const": "EXACT" }
      },
      "additionalProperties": false
    },
    "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ingredient" } },
    "drugs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/drug" } },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["date", "version", "change", "source"] }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rxcui": { "type": "string", "pattern": "^\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rxScope": { "enum": ["PRESCRIPTION_ONLY", "OTC_ONLY", "PRESCRIPTION_AND_OTC"] },
    "provenance": {
      "type": "object",
      "required": ["source", "verified_on"],
      "properties": { "source": { "type": "string", "minLength": 1 }, "verified_on": { "$ref": "#/definitions/date" } }
    },
    "ingredient": {
      "type": "object",
      "required": ["id", "name", "rxcui", "aliases", "provenance"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "rxcui": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/rxcui" }] },
        "tty": { "enum": ["IN", "MIN"] },
        "aliases": { "$ref": "#/definitions/strings" },
        "alias_provenance": { "type": "object", "additionalProperties": { "type": "string" } },
        "precise_ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rxcui", "name"],
            "properties": { "rxcui": { "$ref": "#/definitions/rxcui" }, "name": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "provenance": { "$ref": "#/definitions/provenance" }
      },
      "additionalProperties": false
    },
    "drug": {
      "type": "object",
      "required": ["id", "display_name", "status", "ingredients", "provenance"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "ingredients": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "aliases": { "$ref": "#/definitions/strings" },
        "rx_scope": { "$ref": "#/definitions/rxScope" },
        "restrictions": {
          "type": "object",
          "properties": {
            "routes": { "$ref": "#/definitions/nonEmptyStrings" },
            "dose_forms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["TABLET", "CAPSULE", "SOLUTION", "SUSPENSION", "OTHER"] } },
            "release_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["IR", "ER", "DR"] } },
            "strengths": { "type": "object", "additionalProperties": { "$ref": "#/definitions/nonEmptyStrings" } },
            "precise_ingredients": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "allow": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/rxcui" } },
                  "deny": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/rxcui" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "part_d_rank_2023": { "type": "integer" },
        "notes": { "type": "string" },
        "provenance": { "$ref": "#/definitions/provenance" }
      },
      "additionalProperties": false
    }
  }
}
