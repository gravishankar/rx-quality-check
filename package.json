{
  "name": "rx-quality-check",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, phone-only app that identifies generic medications and retrieves public FDA quality and recall information.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "feasibility": "tsx scripts/check_api_feasibility.ts",
    "feasibility:fixtures": "tsx scripts/check_api_feasibility.ts --save-fixtures",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fixtures:task2": "tsx scripts/capture_task2_fixtures.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='mobile/src/**' \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "catalog:validate": "tsx scripts/config_validate.ts --catalog",
    "policy:validate": "tsx scripts/config_validate.ts --policy",
    "config:validate": "tsx scripts/config_validate.ts",
    "config:test": "tsx scripts/config_validate.ts --test",
    "e2e": "tsx scripts/e2e_cli.ts",
    "e2e:live": "tsx scripts/e2e_cli.ts --live",
    "e2e:record": "tsx scripts/e2e_cli.ts --record",
    "legal:bundle": "tsx scripts/bundle_legal_docs.ts",
    "release:gate": "tsx scripts/release_gate.ts",
    "android:dev": "bash scripts/android_build.sh dev",
    "android:pilot": "bash scripts/android_build.sh pilot",
    "mobile:typecheck": "cd mobile && npx tsc --noEmit -p tsconfig.json",
    "brand:bundle": "tsx scripts/bundle_brand.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.20.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
