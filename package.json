{
  "name": "rx-quality-check",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, phone-only app that identifies generic medications and retrieves public FDA quality and recall information.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "feasibility": "tsx scripts/check_api_feasibility.ts",
    "feasibility:fixtures": "tsx scripts/check_api_feasibility.ts --save-fixtures",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
